# ------------------------------------------------------------------------------
# Sapling / Stump Environment Configuration
# ------------------------------------------------------------------------------

WP_ENV=development # development|staging|production

# ------------------------------------------------------------------------------
# Headless Mode (Stump)
# Set to 'true' to use headless WordPress with REST API + JWT auth
# Leave empty or 'false' for traditional WordPress (Sapling)
# ------------------------------------------------------------------------------
IS_HEADLESS=

# ------------------------------------------------------------------------------
# Theme Configuration
# ------------------------------------------------------------------------------
CHILD_THEME_SLUG=sapling-child
CHILD_THEME_NAME="Your Child Theme"

# WP_HOME=http://sapling-child.localhost:8080
WP_SITEURL=${WP_HOME}/wp

# ------------------------------------------------------------------------------
# Local Ports (change to run multiple projects side by side)
# ------------------------------------------------------------------------------
PHP_PORT=8080
DB_PORT=3307
ADMINER_PORT=8081

# ------------------------------------------------------------------------------
# Setup Flags
# Skip finalize.sh on repeat setup.sh runs (prevents git/.gitignore reset)
# ------------------------------------------------------------------------------
SKIP_FINALIZE=0

# ------------------------------------------------------------------------------
# WordPress Debug & File Settings
# These have sensible defaults per environment (WP_ENV), but can be overridden.
# Values: true / false
# ------------------------------------------------------------------------------
# WP_DEBUG=true
# WP_DEBUG_LOG=true
# WP_DEBUG_DISPLAY=true
# DISALLOW_FILE_EDIT=false
# DISALLOW_FILE_MODS=false
# CONCATENATE_SCRIPTS=false
# AUTOMATIC_UPDATER_DISABLED=false
# DISABLE_WP_CRON=false
# WP_MEMORY_LIMIT=128M
# WP_MAX_MEMORY_LIMIT=256M

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=''
DB_HOST=db
TABLE_PREFIX=splng_

# ------------------------------------------------------------------------------
# Admin User
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=''

# ------------------------------------------------------------------------------
# Theme Repositories
# These are auto-set based on IS_HEADLESS, but can be overridden
# ------------------------------------------------------------------------------
# Traditional (Sapling):
# THEME_REPO=https://github.com/theowolff/sapling-theme.git
# CHILD_REPO=https://github.com/theowolff/sapling-theme-child.git
#
# Headless (Stump):
# THEME_REPO=https://github.com/theowolff/stump-theme.git
# CHILD_REPO=https://github.com/theowolff/stump-theme-child.git
# ------------------------------------------------------------------------------
THEME_REPO=
CHILD_REPO=

# ------------------------------------------------------------------------------
# Git Remote (for finalize.sh - client delivery)
# ------------------------------------------------------------------------------
GIT_REMOTE_URL=

# ------------------------------------------------------------------------------
# Stump (Headless) API Configuration
# Only used when IS_HEADLESS=true
# ------------------------------------------------------------------------------
# REQUIRED for headless: Generate with: openssl rand -base64 32
STMP_JWT_SECRET=

# Token lifetime in seconds (default: 3600 = 1 hour)
STMP_JWT_EXPIRATION=3600

# Enable API request logging (true/false)
STMP_API_DEBUG=false

# Allowed CORS origins (comma-separated)
# Example: http://localhost:3000,https://your-frontend.com
STMP_CORS_ORIGINS=http://localhost:3000
