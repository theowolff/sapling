# BEGIN Sapling Hardening
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block files that leak the WordPress version, and the per-directory ini file.
<FilesMatch "(?i)^(readme\.html|license\.txt|wp-links-opml\.php|\.user\.ini)$">
    Require all denied
</FilesMatch>

# Block XML-RPC (pingback and brute-force surface). Allow if you use the WP app or Jetpack.
<FilesMatch "^xmlrpc\.php$">
    Require all denied
</FilesMatch>
# END Sapling Hardening

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
